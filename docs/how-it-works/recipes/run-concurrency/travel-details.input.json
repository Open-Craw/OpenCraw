{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "travel-details",
  "output": "book",
  "mode": "web",
  "description": "Every book of the Travel category, read from its own page, three tabs at a time.",
  "start": [{ "url": "https://books.toscrape.com/catalogue/category/books/travel_2/index.html" }],
  "limits": { "delayMs": 300, "concurrency": 3, "maxRecords": 6 },
  "steps": [
    { "type": "goto", "url": "{{start.url}}" },
    { "type": "extract", "id": "links", "selector": "article.product_pod h3 a", "kind": "css", "take": "attr:href", "many": true },
    { "type": "forEach", "over": "links", "as": "link", "emit": true, "steps": [
      { "type": "goto", "url": "{{link}}" },
      { "type": "extract", "id": "title", "selector": "div.product_main h1", "kind": "css", "take": "text" },
      { "type": "extract", "id": "price", "selector": "div.product_main p.price_color", "kind": "css", "take": "text" },
      { "type": "extract", "id": "upc", "selector": "table.table-striped tr:first-child td", "kind": "css", "take": "text" }
    ]}
  ],
  "mapping": {
    "url": { "from": "page.url" },
    "title": { "from": "title" },
    "price": { "from": "price", "transform": [{ "op": "currency" }] },
    "upc": { "from": "upc" }
  }
}
