{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "quotes-api",
  "output": "quote",
  "mode": "api",
  "description": "quotes.toscrape.com serves its quotes as JSON, ten a page, with the site's ten most used tags and their counts.",
  "start": [{ "url": "https://quotes.toscrape.com/api/quotes?page=1" }],
  "limits": { "delayMs": 300, "maxRecords": 10 },
  "steps": [
    { "type": "request", "url": "{{start.url}}", "as": "json" },
    { "type": "extract", "id": "topTags", "selector": "$.top_ten_tags", "kind": "jsonpath", "take": "json" },
    { "type": "extract", "id": "quotes", "selector": "$.quotes[*]", "kind": "jsonpath", "take": "json", "many": true },
    { "type": "forEach", "over": "quotes", "as": "quote", "emit": true, "steps": [] }
  ],
  "mapping": {
    "text": { "from": "quote.text", "transform": [{ "op": "replace", "pattern": "^“|”$", "replacement": "" }] },
    "author.name": { "from": "quote.author.name" },
    "author.slug": { "from": "quote.author.slug", "transform": [{ "op": "lowercase" }] },
    "author.url": { "from": "quote.author.goodreads_link", "transform": [{ "op": "absoluteUrl", "base": "https://www.goodreads.com" }] },
    "authorQuery": { "from": "quote.author.name", "transform": [{ "op": "urlEncode" }] },
    "openLibrary": { "from": "quote.author.name", "transform": [{ "op": "template", "value": "https://openlibrary.org/search.json?author={{ urlEncode(quote.author.name) }}" }] },
    "citation": { "from": ["quote.text", "quote.author.name"], "transform": [{ "op": "replace", "pattern": "^“|”$", "replacement": "" }, { "op": "concat", "separator": " — " }] },
    "tagList": { "from": "quote.tags", "transform": [{ "op": "join", "separator": ", " }] },
    "tagCount": { "from": "quote.tags", "transform": [{ "op": "count" }] },
    "mainTag": { "from": "quote.tags", "transform": [{ "op": "first" }] },
    "tagPopularity": { "from": "quote.tags", "transform": [{ "op": "lookup", "in": "topTags", "key": "0", "pick": "1" }] },
    "tags": { "each": "quote.tags", "fields": {
      "name": { "from": "." },
      "url": { "from": ".", "transform": [{ "op": "absoluteUrl", "base": "https://quotes.toscrape.com/tag/" }] }
    }},
    "numberInText": { "from": "quote.text", "transform": [{ "op": "regex", "pattern": "(\\d[\\d,]*)" }, { "op": "number" }] }
  }
}
