{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "link-as-is",
  "output": "book-link",
  "mode": "api",
  "description": "The book links as the page writes them, relative, into a url field: coercion fails, and the output recipe's skip-record drops each book.",
  "start": [{ "url": "https://books.toscrape.com/catalogue/category/books/mystery_3/index.html" }],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "request", "url": "{{start.url}}" },
    { "type": "extract", "id": "books", "selector": "ol.row li:nth-child(-n+3) article.product_pod", "kind": "css", "take": "html", "many": true },
    { "type": "forEach", "over": "books", "as": "book", "emit": true, "steps": [
      { "type": "extract", "id": "title", "from": "book", "selector": "h3 a", "kind": "css", "take": "attr:title" },
      { "type": "extract", "id": "link", "from": "book", "selector": "h3 a", "kind": "css", "take": "attr:href" }
    ]}
  ],
  "mapping": {
    "title": { "from": "title" },
    "url": { "from": "link" }
  }
}
