{
  "$schema": "https://raw.githubusercontent.com/Open-Craw/OpenCraw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "quotes-reject",
  "output": "tagged-quote",
  "mode": "api",
  "description": "mainTag is required; the rule says skip-record, so a quote without tags is dropped and the walk goes on. Pages 3 and 4 of the quotes API; the eighth quote of page 3 has no tags.",
  "start": [
    { "url": "https://quotes.toscrape.com/api/quotes?page=3" },
    { "url": "https://quotes.toscrape.com/api/quotes?page=4" }
  ],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "request", "url": "{{start.url}}", "as": "json" },
    { "type": "extract", "id": "quotes", "selector": "$.quotes[*]", "kind": "jsonpath", "take": "json", "many": true },
    { "type": "forEach", "over": "quotes", "as": "quote", "emit": true, "steps": [] }
  ],
  "mapping": {
    "text": { "from": "quote.text" },
    "author": { "from": "quote.author.name" },
    "mainTag": { "from": "quote.tags", "transform": [{ "op": "first" }], "onMissing": "skip-record" }
  }
}
