{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "stellantis-it-four-tables",
  "output": "dealer-discount",
  "mode": "api",
  "description": "Four tables of the September 2026 ENPAM sheet, the ones whose rows are wrapped over several lines: Alfa Romeo, Jeep, Fiat Professional off-line and DS. A narrow selector picks them, so until also ends a table at the next MODELLI header, which the selector no longer matches.",
  "start": [
    {
      "url": "https://www.enpam.it/wp-content/uploads/STELLANTIS-SCONTI-e-cod-promo_mese-09-2026.pdf",
      "vars": {
        "month": "2026-09"
      }
    }
  ],
  "limits": {
    "delayMs": 1000,
    "timeoutMs": 60000
  },
  "steps": [
    {
      "type": "request",
      "url": "{{start.url}}",
      "as": "pdf"
    },
    {
      "type": "extract",
      "id": "tables",
      "selector": "^MODELLI (ALFA ROMEO|JEEP|FIAT PROFESSIONAL \\(OFF|DS)\\b",
      "kind": "table",
      "many": true,
      "until": "^(NOTA BENE|N\\.B\\.|\\*Si applicano|MODELLI)",
      "columns": {
        "model": "^MODELLI",
        "discount": "^(Sconto|\\(PROMO)",
        "excluded": "^Versioni",
        "extra": "^Azion"
      }
    },
    {
      "type": "forEach",
      "over": "tables",
      "as": "table",
      "steps": [
        {
          "type": "set",
          "id": "rows",
          "value": "{{table.rows}}"
        },
        {
          "type": "forEach",
          "over": "rows",
          "as": "row",
          "emit": true,
          "steps": []
        }
      ]
    }
  ],
  "mapping": {
    "month": {
      "from": "vars.month"
    },
    "brand": {
      "from": "table.title",
      "transform": [
        {
          "op": "regex",
          "pattern": "^MODELLI\\s+(.+?)(?:\\s+OFF-LINE.*|\\s*\\(.*)?$"
        }
      ]
    },
    "channel": {
      "from": "table.title",
      "transform": [
        {
          "op": "regex",
          "pattern": "\\((?:SCONTI )?(ON-LINE|OFF LINE)\\)"
        },
        {
          "op": "lowercase"
        },
        {
          "op": "replace",
          "pattern": "[- ]",
          "replacement": ""
        }
      ]
    },
    "model": {
      "from": "row.model"
    },
    "discountPercent": {
      "from": "row.discount",
      "transform": [
        {
          "op": "regex",
          "pattern": "(\\d+(?:[,.]\\d+)?)\\s?%"
        },
        {
          "op": "number"
        }
      ]
    },
    "excludedVersions": {
      "from": "row.excluded",
      "transform": [
        {
          "op": "default",
          "value": null
        }
      ]
    },
    "extraIncentive": {
      "from": "row.extra",
      "transform": [
        {
          "op": "default",
          "value": null
        }
      ]
    }
  }
}
