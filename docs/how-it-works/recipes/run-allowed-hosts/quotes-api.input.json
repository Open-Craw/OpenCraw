{
  "$schema": "https://raw.githubusercontent.com/Open-Craw/OpenCraw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "quotes-api",
  "output": "quote",
  "mode": "api",
  "description": "Reads the first quote, then follows the footer link to goodreads.com, a host the crawler's allowedHosts does not list.",
  "start": [{ "url": "https://quotes.toscrape.com/" }],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "request", "id": "home", "url": "{{start.url}}", "as": "html" },
    { "type": "extract", "id": "text", "selector": "div.quote span.text", "kind": "css", "take": "text" },
    { "type": "extract", "id": "author", "selector": "div.quote small.author", "kind": "css", "take": "text" },
    { "type": "emit" },
    { "type": "extract", "id": "source", "selector": "footer a", "kind": "css", "take": "attr:href" },
    { "type": "request", "id": "goodreadsPage", "url": "{{source}}", "as": "html" }
  ],
  "mapping": {
    "text": { "from": "text" },
    "author": { "from": "author" }
  }
}
