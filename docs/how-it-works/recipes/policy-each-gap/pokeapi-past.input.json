{
  "$schema": "https://raw.githubusercontent.com/Open-Craw/OpenCraw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "pokeapi-past",
  "output": "past-abilities",
  "mode": "api",
  "description": "PokeAPI lists the abilities a Pokémon had in older generations; for bulbasaur the one entry has \"ability\": null (its hidden ability did not exist before generation V). The items' name is required and nothing sets a policy, so the mapping fails.",
  "start": [{ "url": "https://pokeapi.co/api/v2/pokemon/bulbasaur" }],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "request", "url": "{{start.url}}", "as": "json" },
    { "type": "extract", "id": "name", "selector": "$.name", "kind": "jsonpath", "take": "text" },
    { "type": "extract", "id": "past", "selector": "$.past_abilities[*]", "kind": "jsonpath", "take": "json", "many": true },
    { "type": "emit" }
  ],
  "mapping": {
    "name": { "from": "name" },
    "pastAbilities": { "each": "past", "fields": {
      "name": { "from": "abilities[0].ability.name" },
      "slot": { "from": "abilities[0].slot" },
      "until": { "from": "generation.name" }
    }}
  }
}
