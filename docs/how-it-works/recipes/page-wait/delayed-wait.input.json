{
  "$schema": "https://raw.githubusercontent.com/Open-Craw/OpenCraw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "delayed-wait",
  "output": "quote",
  "mode": "web",
  "description": "The delayed page again, with a wait for the first quote before the extract.",
  "start": [{ "url": "https://quotes.toscrape.com/js-delayed/" }],
  "limits": { "delayMs": 300, "maxRecords": 2 },
  "steps": [
    { "type": "goto", "url": "{{start.url}}" },
    { "type": "wait", "selector": ".quote", "timeoutMs": 15000 },
    { "type": "extract", "id": "first", "selector": ".quote .text", "kind": "css", "take": "text" },
    { "type": "extract", "id": "quotes", "selector": ".quote", "kind": "css", "take": "html", "many": true },
    { "type": "forEach", "over": "quotes", "as": "quote", "emit": true, "steps": [
      { "type": "extract", "id": "text", "from": "quote", "selector": ".text", "kind": "css", "take": "text" },
      { "type": "extract", "id": "author", "from": "quote", "selector": ".author", "kind": "css", "take": "text" },
      { "type": "extract", "id": "tags", "from": "quote", "selector": ".tag", "kind": "css", "take": "text", "many": true }
    ]}
  ],
  "mapping": {
    "text": { "from": "text" },
    "author": { "from": "author" },
    "tags": { "from": "tags" }
  }
}
