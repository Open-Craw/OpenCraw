{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "mystery-web",
  "output": "book",
  "mode": "web",
  "vars": { "category": "Mystery" },
  "start": [{ "url": "https://books.toscrape.com/catalogue/category/books/mystery_3/index.html" }],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "goto", "url": "{{start.url}}" },
    { "type": "set", "id": "starWords", "value": [{ "word": "One", "n": 1 }, { "word": "Two", "n": 2 }, { "word": "Three", "n": 3 }, { "word": "Four", "n": 4 }, { "word": "Five", "n": 5 }] },
    { "type": "paginate", "next": { "selector": "li.next a" }, "maxPages": 2, "steps": [
      { "type": "extract", "id": "books", "selector": "article.product_pod", "kind": "css", "take": "html", "many": true },
      { "type": "forEach", "over": "books", "as": "book", "emit": true, "steps": [
        { "type": "extract", "id": "title", "from": "book", "selector": "h3 a", "kind": "css", "take": "attr:title" },
        { "type": "extract", "id": "link", "from": "book", "selector": "h3 a", "kind": "css", "take": "attr:href" },
        { "type": "extract", "id": "price", "from": "book", "selector": ".price_color", "kind": "css", "take": "text" },
        { "type": "extract", "id": "rating", "from": "book", "selector": "p.star-rating", "kind": "css", "take": "attr:class" },
        { "type": "extract", "id": "stock", "from": "book", "selector": ".availability", "kind": "css", "take": "text" }
      ]}
    ]}
  ],
  "mapping": {
    "url": { "from": "link", "transform": [{ "op": "absoluteUrl" }] },
    "title": { "from": "title" },
    "price": { "from": "price", "transform": [{ "op": "currency" }] },
    "stars": { "from": "rating", "transform": [{ "op": "regex", "pattern": "star-rating (\\w+)" }, { "op": "lookup", "in": "starWords", "key": "word", "pick": "n" }] },
    "inStock": { "from": "stock", "transform": [{ "op": "trim" }, { "op": "boolean", "truthy": ["in stock"] }] },
    "category": { "from": "vars.category" },
    "page": { "from": "page.number" }
  }
}
