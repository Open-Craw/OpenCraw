{
  "$schema": "https://raw.githubusercontent.com/russoedu/open.craw/main/packages/core/schemas/input-recipe.schema.json",
  "kind": "input",
  "id": "attic-api",
  "output": "book-detail",
  "mode": "api",
  "start": [{ "url": "https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html" }],
  "limits": { "delayMs": 300 },
  "steps": [
    { "type": "request", "url": "{{start.url}}" },
    { "type": "extract", "id": "title", "selector": ".product_main h1", "kind": "css" },
    { "type": "extract", "id": "price", "selector": ".product_main .price_color", "kind": "css" },
    { "type": "extract", "id": "stock", "selector": ".product_main .availability", "kind": "css" },
    { "type": "extract", "id": "upc", "selector": "table.table-striped tr:nth-child(1) td", "kind": "css" },
    { "type": "extract", "id": "productType", "selector": "table.table-striped tr:nth-child(2) td", "kind": "css" },
    { "type": "extract", "id": "excl", "selector": "table.table-striped tr:nth-child(3) td", "kind": "css" },
    { "type": "extract", "id": "incl", "selector": "table.table-striped tr:nth-child(4) td", "kind": "css" },
    { "type": "extract", "id": "tax", "selector": "table.table-striped tr:nth-child(5) td", "kind": "css" },
    { "type": "extract", "id": "reviews", "selector": "table.table-striped tr:nth-child(7) td", "kind": "css" },
    { "type": "extract", "id": "image", "selector": "#product_gallery img", "kind": "css", "take": "attr:src" },
    { "type": "extract", "id": "breadcrumb", "selector": "ul.breadcrumb li a", "kind": "css", "many": true },
    { "type": "extract", "id": "rows", "selector": "table.table-striped tr", "kind": "css", "many": true },
    { "type": "extract", "id": "oldPrice", "selector": ".product_main .price_old", "kind": "css", "onError": { "policy": "skip" } },
    { "type": "extract", "id": "saleBadge", "selector": ".product_main .sale", "kind": "css", "onError": { "policy": "skip" } },
    { "type": "extract", "id": "subtitle", "selector": ".product_main h2", "kind": "css", "onError": { "policy": "skip" } },
    { "type": "emit" }
  ],
  "mapping": {
    "upc": { "from": "upc" },
    "title": { "from": "title" },
    "price": { "from": "price" },
    "priceValue": { "from": "price" },
    "prices.excl": { "from": "excl" },
    "prices.incl": { "from": "incl" },
    "prices.tax": { "from": "tax" },
    "inStock": { "from": "stock" },
    "available": { "from": "stock" },
    "reviews": { "from": "reviews" },
    "productType": { "from": "productType" },
    "image": { "from": "image", "transform": [{ "op": "absoluteUrl" }] },
    "breadcrumb": { "from": "breadcrumb" },
    "rows": { "from": "rows" },
    "oldPrice": { "from": "oldPrice" },
    "onSale": { "from": "saleBadge" },
    "subtitle": { "from": "subtitle" }
  }
}
