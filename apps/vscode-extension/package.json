{
  "name": "@opencraw/vscode",
  "version": "0.0.4",
  "private": true,
  "description": "OpenCraw in the editor: starts the Studio server and opens a folder, recipe or document in the browser.",
  "type": "module",
  "main": "dist/extension.cjs",
  "displayName": "OpenCraw",
  "publisher": "opencraw",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencraw",
          "title": "OpenCraw",
          "icon": "media/opencraw-activity-bar.svg"
        }
      ]
    },
    "views": {
      "opencraw": [
        {
          "id": "opencraw.start",
          "name": "OpenCraw"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "opencraw.start",
        "contents": "Run recipes in your browser: Studio starts a local server and opens the page.\n[Open Studio](command:opencraw.openStudio)\nTo open a folder, recipe or document, right-click it in the Explorer and choose **Open on OpenCraw**."
      }
    ],
    "configuration": {
      "title": "OpenCraw",
      "properties": {
        "opencraw.hooksFile": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Absolute path of a hooks or plugins module (the `--hooks` of `opencraw studio`) Studio runs recipes with. It runs as your code. Only your user settings can set it, never a workspace's, so a repository cannot make Studio run its code."
        }
      }
    },
    "commands": [
      {
        "command": "opencraw.openStudio",
        "title": "Open Studio",
        "category": "OpenCraw"
      },
      {
        "command": "opencraw.openOn",
        "title": "Open on OpenCraw",
        "category": "OpenCraw"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "opencraw.openOn",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "opencraw.openOn",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencraw.openOn",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "opencraw.openOn",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/vscode-extension/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/vscode-extension/src/extension.ts",
          "tsConfig": "apps/vscode-extension/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".cjs"
            }
          },
          "thirdParty": false,
          "assets": [
            {
              "input": "apps/vscode-extension/src/studio-host",
              "glob": "studio-host.process.mjs",
              "output": "."
            }
          ],
          "external": [
            "vscode",
            "@opencraw/*"
          ]
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".cjs"
              }
            }
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "@opencraw/studio:build",
          "@opencraw/studio-ui:build"
        ],
        "cache": false,
        "options": {
          "command": "node packaging/package-vsix.mjs --stage-only && node e2e/run-editor-test.mjs",
          "cwd": "apps/vscode-extension"
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "@opencraw/studio:build",
          "@opencraw/studio-ui:build"
        ],
        "cache": false,
        "options": {
          "command": "node packaging/package-vsix.mjs",
          "cwd": "apps/vscode-extension"
        }
      }
    }
  },
  "dependencies": {
    "@opencraw/cli": "^0.0.1",
    "@opencraw/studio": "^0.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0"
  }
}
