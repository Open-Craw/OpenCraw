{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraw/schemas/driver-protocol.schema.json",
  "title": "OpenCraw driver protocol",
  "description": "JSON-RPC 2.0 over stdio, one message per line. Methods with a result are requests; the rest are notifications.",
  "protocolVersion": "1.0.0",
  "methods": {
    "initialize": {
      "direction": "client-to-driver",
      "params": {
        "$ref": "#/$defs/initialize.params"
      },
      "result": {
        "$ref": "#/$defs/initialize.result"
      }
    },
    "validate": {
      "direction": "client-to-driver",
      "params": {
        "$ref": "#/$defs/validate.params"
      },
      "result": {
        "$ref": "#/$defs/validate.result"
      }
    },
    "run": {
      "direction": "client-to-driver",
      "params": {
        "$ref": "#/$defs/run.params"
      },
      "result": {
        "$ref": "#/$defs/run.result"
      }
    },
    "cancel": {
      "direction": "client-to-driver",
      "params": {
        "$ref": "#/$defs/cancel.params"
      },
      "result": {
        "$ref": "#/$defs/cancel.result"
      }
    },
    "shutdown": {
      "direction": "client-to-driver",
      "result": {
        "$ref": "#/$defs/shutdown.result"
      }
    },
    "callout": {
      "direction": "driver-to-client",
      "params": {
        "$ref": "#/$defs/callout.params"
      },
      "result": {
        "$ref": "#/$defs/callout.result"
      }
    },
    "event": {
      "direction": "driver-to-client",
      "params": {
        "$ref": "#/$defs/event.params"
      }
    },
    "record": {
      "direction": "driver-to-client",
      "params": {
        "$ref": "#/$defs/record.params"
      }
    },
    "finished": {
      "direction": "driver-to-client",
      "params": {
        "$ref": "#/$defs/finished.params"
      }
    }
  },
  "$defs": {
    "initialize.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "minLength": 1
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "clientName",
        "clientVersion",
        "protocolVersion"
      ],
      "additionalProperties": false
    },
    "initialize.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "driverVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "driverVersion",
        "protocolVersion",
        "methods"
      ],
      "additionalProperties": false
    },
    "validate.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validate.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "recipeId": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "inputs",
        "hooks",
        "issues"
      ],
      "additionalProperties": false
    },
    "run.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "string"
        },
        "append": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "browser": {
          "type": "object",
          "properties": {
            "headless": {
              "type": "boolean"
            },
            "executablePath": {
              "type": "string"
            },
            "ignoreHTTPSErrors": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "run.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "additionalProperties": false
    },
    "cancel.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "additionalProperties": false
    },
    "cancel.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cancelled": {
          "type": "boolean"
        }
      },
      "required": [
        "cancelled"
      ],
      "additionalProperties": false
    },
    "shutdown.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "callout.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "hook",
                "captcha",
                "access"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "input": {},
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "context": {
              "type": "object",
              "properties": {
                "recipeId": {
                  "type": "string"
                },
                "scope": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "recipeId",
                "scope"
              ],
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string"
            },
            "callback": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "name",
            "args",
            "context",
            "idempotencyKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runId",
        "request"
      ],
      "additionalProperties": false
    },
    "callout.result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "output": {}
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "pending"
            },
            "retryAfterMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "event": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "runId",
        "event"
      ],
      "additionalProperties": false
    },
    "record.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "recipeId": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "runId",
        "recipeId",
        "key",
        "data"
      ],
      "additionalProperties": false
    },
    "finished.params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "report": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "additionalProperties": false
    }
  }
}
