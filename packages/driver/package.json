{
  "name": "@opencraw/driver",
  "version": "0.0.0",
  "description": "OpenCraw's driver: the engine over JSON-RPC on stdio, for clients in other languages",
  "license": "MIT",
  "type": "module",
  "smith": {
    "kind": "package",
    "stack": "node-vitest"
  },
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "bin": {
    "opencraw-driver": "./dist/main.esm.js"
  },
  "files": [
    "dist",
    "schemas",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/main.ts --bundle --packages=external --platform=node --format=esm --outdir=dist --out-extension:.js=.esm.js --sourcemap && tsc -p tsconfig.build.json && node ../../declaration-specifiers.mjs dist/src",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "schemas": "node tools/emit-protocol-schema.mjs"
  },
  "dependencies": {
    "@opencraw/cli": "^0.0.1",
    "@opencraw/core": "^0.0.1",
    "zod": "^4.6.5"
  }
}
