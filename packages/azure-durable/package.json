{
  "name": "@opencraw/azure-durable",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@azure/functions": ">=4.0.0 <5",
    "@azure/storage-blob": "^12.34.0",
    "@mnci/az-durable": "^0.1.12",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opencraw/cli": "^0.0.1",
    "@opencraw/core": "^0.0.1",
    "@opencraw/mcp": "^0.0.1",
    "durable-functions": ">=3.0.0 <4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@azure/functions": ">=4.0.0 <5",
    "durable-functions": ">=3.0.0 <4"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "OpenCraw over HTTP on Azure Durable Functions: run recipes with one call, or feed warm worker pools one item at a time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/open.craw.git",
    "directory": "packages/azure-durable"
  },
  "keywords": [
    "crawler",
    "scraper",
    "azure-functions",
    "durable-functions",
    "recipe"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      },
      "e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          {
            "projects": [
              "@opencraw/core"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/packages/core/e2e/**"
        ],
        "options": {
          "command": "tsc -p tsconfig.e2e.json && jest --config jest.e2e.config.cts",
          "cwd": "packages/azure-durable"
        }
      }
    }
  }
}
