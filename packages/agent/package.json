{
  "name": "@opencraw/agent",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "The OpenCraw agent: one specification of a specialist developer who builds OpenCraw recipes with you (its persona, workflow, knowledge and tools), and the files that put it into GitHub Copilot, Claude Code or any AGENTS.md reader. Shared by the VS Code extension and the Studio's chatbot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Craw/OpenCraw.git",
    "directory": "packages/agent"
  },
  "keywords": [
    "agent",
    "mcp",
    "recipe",
    "crawler",
    "copilot",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
