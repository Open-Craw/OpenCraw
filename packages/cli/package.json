{
  "name": "@opencraw/cli",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "opencraw": "./bin/opencraw.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@opencraw/core": "^0.0.1",
    "@opencraw/probe": "^0.0.1",
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "@opencraw/studio": "^0.0.1"
  },
  "peerDependenciesMeta": {
    "@opencraw/studio": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Command-line tools for OpenCraw: probe a page for scrapable data, validate recipes, run a crawl.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Craw/OpenCraw.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "crawler",
    "scraper",
    "cli",
    "recipe"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --format=esm --outfile=dist/index.esm.js --sourcemap && tsc -p tsconfig.lib.json --emitDeclarationOnly --declaration --declarationDir dist/src --tsBuildInfoFile dist/src/tsconfig.lib.tsbuildinfo && node ../../declaration-specifiers.mjs dist/src",
    "e2e": "tsc -p tsconfig.e2e.json && jest --config jest.e2e.config.cts",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly"
  }
}
