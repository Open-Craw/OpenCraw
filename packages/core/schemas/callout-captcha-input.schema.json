{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "challenge": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "recaptcha-v2",
            "recaptcha-v3",
            "hcaptcha",
            "turnstile",
            "image",
            "unknown"
          ]
        },
        "url": {
          "type": "string"
        },
        "siteKey": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "refresh": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "string"
    },
    "proxy": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "server"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "challenge",
    "attempt"
  ],
  "additionalProperties": false,
  "$id": "https://opencraw/schemas/callout-captcha-input.schema.json",
  "title": "OpenCraw captcha callout input"
}
