      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
