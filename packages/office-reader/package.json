{
  "name": "@opencraw/office-reader",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    },
    "./xlsx": {
      "types": "./dist/src/spreadsheet/index.d.ts",
      "import": "./dist/xlsx.esm.js",
      "default": "./dist/xlsx.esm.js"
    },
    "./pptx": {
      "types": "./dist/src/presentation/index.d.ts",
      "import": "./dist/pptx.esm.js",
      "default": "./dist/pptx.esm.js"
    },
    "./docx": {
      "types": "./dist/src/document/index.d.ts",
      "import": "./dist/docx.esm.js",
      "default": "./dist/docx.esm.js"
    },
    "./ods": {
      "types": "./dist/src/opendocument-spreadsheet/index.d.ts",
      "import": "./dist/ods.esm.js",
      "default": "./dist/ods.esm.js"
    },
    "./odt": {
      "types": "./dist/src/opendocument-text/index.d.ts",
      "import": "./dist/odt.esm.js",
      "default": "./dist/odt.esm.js"
    },
    "./odp": {
      "types": "./dist/src/opendocument-presentation/index.d.ts",
      "import": "./dist/odp.esm.js",
      "default": "./dist/odp.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Reads Office files (.xlsx workbooks, .pptx presentations, .docx documents) into plain objects: cells with merged ranges and hidden rows, slides with positioned text, tables and chart data, document paragraphs with headings, lists and tables. No Node built-ins beyond reading a path: runs in Node, browsers, workers and edge runtimes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Craw/OpenCraw.git",
    "directory": "packages/office-reader"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "pptx",
    "powerpoint",
    "presentation",
    "docx",
    "word",
    "office",
    "ooxml",
    "reader",
    "parser",
    "json"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --format=esm --outfile=dist/index.esm.js --sourcemap && tsc -p tsconfig.lib.json --emitDeclarationOnly --declaration --declarationDir dist/src --tsBuildInfoFile dist/src/tsconfig.lib.tsbuildinfo && node ../../declaration-specifiers.mjs dist/src",
    "e2e": "tsc -p tsconfig.e2e.json && jest --config jest.e2e.config.cts",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --build tsconfig.json --emitDeclarationOnly"
  },
  "smith": {
    "playwright": {
      "flavour": "library"
    }
  }
}
