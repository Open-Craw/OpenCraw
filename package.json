{
  "name": "@opencraw/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "smith run build",
    "lint": "smith run lint",
    "test": "smith run test",
    "typecheck": "smith run typecheck",
    "affected": "smith run lint typecheck test build --affected",
    "graph": "smith graph",
    "release:preview": "smith release --dry-run",
    "prepare": "husky",
    "format": "eslint . --fix --cache",
    "core:e2e": "smith run e2e -p core",
    "core:schemas": "smith run schemas -p core",
    "playwright:install": "playwright install chromium",
    "examples:check": "smith run build -p core && node examples/check.mjs",
    "examples:test": "smith run build -p core,cli && node --test \"examples/*/*.test.mjs\"",
    "docs:capture": "smith run build -p core && node docs/how-it-works/capture/capture.mjs",
    "docs:check": "smith run build -p core && node docs/how-it-works/capture/capture.mjs --check",
    "cli:e2e": "smith run e2e -p cli",
    "office-reader:e2e": "smith run e2e -p office-reader",
    "captcha-tesseract:e2e": "smith run e2e -p captcha-tesseract",
    "azure-durable:e2e": "smith run e2e -p azure-durable",
    "studio:e2e": "smith run e2e -p studio",
    "studio-desktop:e2e": "smith run e2e -p studio-desktop",
    "studio-desktop:package": "smith run package -p studio-desktop",
    "studio-desktop:package:dir": "smith run package:dir -p studio-desktop",
    "vscode:qa": "smith run lint -p vscode-extension && smith run test -p vscode-extension",
    "vscode:build": "smith run build -p vscode-extension",
    "vscode:package": "smith run package -p vscode-extension",
    "vscode:e2e": "smith run e2e -p vscode-extension",
    "lint:workspace": "eslint . --cache --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"python-packages/**\" --ignore-pattern package-lock.json"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@monosmith/eslint-config": "^1.0.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "adm-zip": "^0.6.1",
    "azurite": "^3.37.0",
    "babel-jest": "~30.3.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.64.8",
    "swc-loader": "0.1.15",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "axios": "^1.20.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    },
    "@verdaccio/config": {
      "js-yaml": "^5.4.2"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "brace-expansion@4.0.0 - 5.0.8": "^5.0.9",
    "uuid": "^11.1.1",
    "compression": "^1.8.2",
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "motion": "^14.3.0"
  }
}
